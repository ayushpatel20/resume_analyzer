# AI Resume Analyzer and Job Matching System - Environment Configuration

# Application
PROJECT_NAME="AI Resume Analyzer and Job Matching System"
VERSION="1.0.0"

# JWT Security
SECRET_KEY="your-super-secret-jwt-signing-key-here-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default zero-setup SQLite:
DATABASE_URL="sqlite:///./resume_analyzer.db"
# Optional PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_analyzer_db"

# Upload Limits (10 MB in bytes)
MAX_UPLOAD_SIZE_BYTES=10485760

# Frontend API URL (for production or containerized environments)
VITE_API_URL="http://localhost:8000/api"
