# AI Resume Analyzer and Job Matching System - Environment Configuration

# Application
PROJECT_NAME="AI Resume Analyzer and Job Matching System"
VERSION="1.0.0"

# JWT Security
SECRET_KEY="your-super-secret-jwt-signing-key-here-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./resume_analyzer.db"
# Vercel Serverless ephemeral default:
# DATABASE_URL="sqlite:////tmp/resume_analyzer.db"
# Production Cloud PostgreSQL (Neon, Supabase, Vercel Postgres):
# DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require"

# Vercel Serverless / Large Functions Configuration
# Enable larger Lambda deployment packages (up to 500 MB for Scikit-learn, NumPy, PyMuPDF, ReportLab):
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Upload Limits (10 MB in bytes)
MAX_UPLOAD_SIZE_BYTES=10485760

# Frontend API URL
# Leave empty or unset in production Vercel deployment so relative same-origin /api is used:
# VITE_API_URL="/api"
# For local independent dev servers:
VITE_API_URL="http://localhost:8000/api"
